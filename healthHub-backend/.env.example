PORT=5000

# Get this from MongoDB Atlas: Database > Connect > Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/healthhub

# Any long random string — used to sign JWTs
JWT_SECRET=replace_this_with_a_long_random_string

# Your Next.js app's URL — needed for CORS
CLIENT_URL=http://localhost:3000

# Free API key from aistudio.google.com — used for the patient chatbot
GEMINI_API_KEY=your_gemini_api_key_here
